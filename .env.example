# Copy this to .env (local dev) and set the same names in Vercel's project
# settings (Production + Preview) for the deployed app. Never commit .env -
# it's gitignored. The service-role key in particular must never reach the
# client; it's only ever read in server components, route handlers, and the
# standalone scripts/ tools below.

# Onshape API key pair, from https://dev-portal.onshape.com/keys
# Needs read scope on your documents. Used by scripts/backfill.mjs,
# scripts/webhooks.mjs, and the two Vercel Cron routes under src/app/api/cron.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=

# Supabase project settings -> API. Both server-only: there is no client-side
# Supabase usage in Phase 1 (no auth, no client subscriptions), so neither
# needs (or gets) the NEXT_PUBLIC_ prefix that would bundle it into JS shipped
# to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 1b - live capture via webhooks.
#
# The public URL Onshape POSTs notifications to - must be the deployed
# Vercel app, never localhost (Onshape has to reach it from the internet).
# Used by scripts/webhooks.mjs and the daily discovery cron to register new
# webhooks. Example: https://xtrude.vercel.app/api/webhooks/onshape
WEBHOOK_URL=

# Shared secret the daily Vercel Cron and the hourly GitHub Action send as
# `Authorization: Bearer <value>`. Set it in Vercel (Project → Settings →
# Environment Variables) AND as a GitHub Actions repository secret of the
# same name (repo → Settings → Secrets and variables → Actions). If unset,
# the cron routes accept any request unauthenticated; fine for local
# testing, not for the deployed app.
CRON_SECRET=

# Optional. Defaults to Yoni's users.id in supabase/migrate-users.sql
# (e7b3c91a-4d2f-4a8e-9c15-6f8a2d4b1e70). Only set this if that row's uuid
# ever changes. No OAuth yet: every server query is scoped to this id.
# XTRUDE_USER_ID=

# Web Push (VAPID). Server-only — never NEXT_PUBLIC_. If unset, push is
# simply unavailable; Today still works.
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_VAPID_SUBJECT=mailto:you@example.com

